BSKY_USERNAME=
BSKY_PASSWORD=
# Optional AI agenda and minutes summaries; leave LLM_API_KEY empty to turn them off.
# Any OpenAI-compatible Chat Completions API works; the defaults use Gemini.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
# Nonce for the <untrusted_{nonce}> tags that wrap agenda/minutes text sent to the
# LLM (prompt-injection guard): 8-64 letters, digits, "_" or "-". Unset or invalid,
# a random one is made each run. Treat it as a secret.
LLM_UNTRUSTED_NONCE=
